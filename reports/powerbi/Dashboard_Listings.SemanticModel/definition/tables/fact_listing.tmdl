table fact_listing
	lineageTag: c4656762-971a-5af6-ba4f-666206253f0d

	measure Anuncios = COUNTROWS ( fact_listing )
		formatString: #,0
		lineageTag: 538624ca-864a-52ec-8d98-aef1da163829

	measure 'Precio Mediano' = MEDIAN ( fact_listing[price] )
		formatString: \$#,0
		lineageTag: f91f199c-09b6-5adb-ab6d-0176a855812d

	measure 'Tasa de Ocupación' = DIVIDE ( AVERAGE ( fact_listing[estimated_occupancy_l365d] ), 365 )
		formatString: 0.0%
		lineageTag: fe133b52-01ae-57a0-a2f2-3cb7a3c6f34c

	measure 'Ingreso Anual Promedio' = AVERAGE ( fact_listing[estimated_revenue_l365d] )
		formatString: \$#,0
		lineageTag: 13dd79ea-c869-5b85-a986-1aeed370260c

	measure 'Calificación Promedio' = AVERAGE ( fact_listing[review_scores_rating] )
		formatString: 0.00
		lineageTag: e9d243a5-6df6-5194-a853-1c6238f11147

	measure '% Superhost' = DIVIDE ( CALCULATE ( [Anuncios], dim_host[es_superhost] = 1 ), [Anuncios] )
		formatString: 0.0%
		lineageTag: f70a0120-4dcf-5bd5-8d9e-ebee4485ced3

